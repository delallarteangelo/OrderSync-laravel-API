APP_NAME=OrderSync
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ordersync_test
DB_USERNAME=ordersync_test
DB_PASSWORD=
DB_TIMEZONE=+00:00

AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_MINUTES=43200
AUTH_REFRESH_COOKIE=ordersync_refresh
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:5173
PAYMENT_PROOF_RETENTION_DAYS=365

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
BROADCAST_CONNECTION=null
AI_SUPPORT_PROVIDER=local
GEMINI_API_KEY=
