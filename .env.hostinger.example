APP_NAME=OrderSync
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Hostinger uses MariaDB through PHP's mysql PDO driver.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=YOUR_HOSTINGER_DATABASE
DB_USERNAME=YOUR_HOSTINGER_DATABASE_USER
DB_PASSWORD=YOUR_HOSTINGER_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_MINUTES=43200
AUTH_REFRESH_COOKIE=ordersync_refresh
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=https://YOUR-DOMAIN.example
PAYMENT_PROOF_RETENTION_DAYS=365

AI_SUPPORT_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=12
GEMINI_PAID_TIER=false
GEMINI_ESTIMATED_PHP_PER_USD=60

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting has no always-running queue worker. Synchronous jobs are safest
# for this small capstone deployment.
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@YOUR-DOMAIN.example"
MAIL_FROM_NAME="${APP_NAME}"

